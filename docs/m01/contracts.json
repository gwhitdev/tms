  "valueTypes": [
    {
      "name": "TenantReference",
      "fields": {
        "tenantId": "nonempty UUID",
        "id": "nonempty UUID"
      },
      "policy": "Validate against authenticated command tenant at every boundary. Default/empty references rejected by rules.",
      "exampleImplemented": true
    },
    {
      "name": "Quantity",
      "fields": {
        "value": "nonnegative decimal",
        "unit": "explicit recognised unit code",
        "dimension": "count|mass|volume|seats"
      },
      "policy": "Booked quantities positive; approved conversion retained; dimensions cannot be interchanged.",
      "exampleImplemented": "integer cargo units and one decimal load dimension only"
    },
    {
      "name": "TimeWindow",
      "fields": {
        "startUtc": "UTC instant",
        "endUtc": "UTC instant",
        "originTimezone": "IANA timezone",
        "ambiguityPolicy": "explicit policy"
      },
      "policy": "Positive duration, half-open [start,end). Local/DST parsing must retain timezone and explicit ambiguity resolution.",
      "exampleImplemented": "UTC interval only"
    },
    {
      "name": "Coordinate",
      "fields": {
        "latitude": "decimal -90..90",
        "longitude": "decimal -180..180"
      },
      "policy": "Accuracy and timestamps are source metadata; coordinate proximity does not prove delivery.",
      "exampleImplemented": false
    },
    {
      "name": "Money",
      "fields": {
        "amount": "nonnegative decimal",
        "currency": "three uppercase currency letters"
      },
      "policy": "Currency precision/rounding policies reviewed. Credits use distinct document/amount semantics.",
      "exampleImplemented": "GBP total example with two decimals, midpoint away from zero; no tax/FX policy"
    }
  ],
  "commandContracts": [
    {
      "name": "dispatch.publish",
      "version": 1,
      "owner": "dispatch",
      "required": [
        "tenantId",
        "actorId",
        "requestId",
        "planId",
        "planVersion",
        "expectedBookingVersions",
        "expectedResourceVersions",
        "reservationGroup",
        "reason"
      ],
      "policy": "Revalidate current versions and feasibility through owning ports. Commit run, grouped Resources commitments and owner outboxes within one application unit of work. Conflict leaves no published run or partial reservation.",
      "authorisation": "dispatch grant plus tenant/depot/subcontractor allocation scope; site/menu visibility irrelevant",
      "exampleImplemented": false
    },
    {
      "name": "resources.commit_reservations",
      "version": 1,
      "owner": "resources",
      "required": [
        "tenantId",
        "taskId",
        "reservationId",
        "expectedVersion",
        "resources",
        "startUtc",
        "endUtc",
        "requestId"
      ],
      "policy": "No duplicate active task, repeated resource, cross-tenant reference or overlapping exclusive interval. Commit grouped driver/vehicle/trailer resources all or nothing. Expected version is not silently changed on retry.",
      "exampleImplemented": "pure policy plus in-memory CAS only"
    },
    {
      "name": "execution.record_delivery",
      "version": 1,
      "owner": "execution",
      "required": [
        "tenantId",
        "consignmentId",
        "taskId",
        "attemptId",
        "deliveredQuantity",
        "unit",
        "observedAtUtc",
        "requestId"
      ],
      "optional": [
        "evidenceReference",
        "exceptionReason"
      ],
      "policy": "Positive delivered quantity requires evidence; incomplete/failed attempts require reason. Same attempt ID/body is idempotent; changed-body replay rejected. Validate current assignment and remaining quantity.",
      "exampleImplemented": "integer quantity/evidence/reason/idempotency policy; no assignment/API/DB"
    },
    {
      "name": "commercial.approve_charge",
      "version": 1,
      "owner": "commercial",
      "required": [
        "tenantId",
        "chargeId",
        "agreementId",
        "rateVersion",
        "quantityBasis",
        "currency",
        "approvalReference",
        "actorId",
        "requestId"
      ],
      "policy": "Agreed snapshot retained; approved extras use matching currency. Issued financial correction is a separate linked document.",
      "exampleImplemented": "snapshot/extra charge total policy only"
    },
    {
      "name": "integrations.receive_erp",
      "version": 1,
      "owner": "integrations",
      "required": [
        "connectorId",
        "externalOperationId",
        "externalStatus",
        "payload",
        "mappingVersion"
      ],
      "policy": "Server-verified scoped connector determines tenant. Anti-corruption mapping yields a reported milestone/owned command. Unknown status/schema/ID or conflict becomes reconciliation; never directly assigns operational/financial state.",
      "exampleImplemented": "four exact illustrative statuses only"
    }
  ],
  "eventEnvelope": {
    "schemaVersion": 1,
    "required": {
      "eventId": "UUID stable across retry",
      "tenantId": "UUID command scope",
      "eventType": "registered owner event name",
      "schemaVersion": "supported positive integer",
      "producer": "registered bounded context",
      "aggregate": {
        "type": "registered aggregate type",
        "tenantId": "same as envelope tenantId",
        "id": "UUID"
      },
      "aggregateSequence": "positive integer increasing per producer/tenant/aggregate",
      "occurredAtUtc": "ISO-8601 UTC instant",
      "correlationId": "UUID",
      "payload": "owner/version validated object"
    },
    "optional": {
      "causationId": "UUID source command/event"
    },
    "executableSubset": [
      "eventId",
      "tenantId",
      "aggregate tenant/id",
      "eventType nonempty",
      "schemaVersion exactly 1",
      "aggregateSequence positive",
      "occurredAtUtc offset zero",
      "correlationId"
    ],
    "transportPolicy": {
      "outbox": "Business mutation and owner's outbox atomically committed; retries preserve event ID.",
      "inbox": "Consumer key includes tenant, producer and event ID; inbox receipt and mutation commit together.",
      "ordering": "Ordered consumers retain/reconcile gaps; acknowledged sequences cannot reverse valid completion or duplicate a charge.",
      "compatibility": "Unknown major/schema version enters reconciliation. Compatible optional additions need contract tests.",
      "audit": "Sensitive changes record tenant, actor, before/after reference, time, reason/approval. No secrets/raw tokens in payloads."
    },
    "implemented": false
  },
