  "boundaryPolicy": {
    "deployment": "Modular application first; independent workers. Separate service deployments need explicit justification.",
    "persistence": "Each context owns its schema/repositories. No direct cross-context persistence access.",
    "publication": "Dispatch revalidates immutable proposal and authoritative booking/resource versions; shared application unit of work enlists Dispatch and Resources owning ports in one PostgreSQL transaction for run, commitments and each owner's outbox. Each owner writes its own tables.",
    "security": "Tenant-qualified identity is required but is not authentication or authorisation. Server policy/RLS and all data-surface isolation need real implementation and database/API tests.",
    "architectureVerification": "Context dependency/persistence checks are planned when production modules exist; these examples do not prove module isolation.",
    "status": "design_not_production_implementation"
  },
