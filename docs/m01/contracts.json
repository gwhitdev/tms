  "positionIngestionContract": {
    "owner": "tracking",
    "version": 1,
    "required": [
      "sourceId",
      "sessionId",
      "sourceSequence",
      "observedAtUtc",
      "latitude",
      "longitude",
      "accuracyMetres"
    ],
    "serverFields": [
      "authenticated tenant/assignment",
      "receivedAtUtc"
    ],
    "policy": [
      "Authenticate scoped source and current work session; do not trust a body tenantId.",
      "Delayed positions append history without replacing newer live state.",
      "Expose freshness/permission/offline state; do not infer work completion from GPS.",
      "Vehicle telematics is a later adapter to source assignment contract."
    ],
    "implemented": false
  },
  "lifecyclePolicies": {
    "operationalExample": {
      "states": [
        "Draft",
        "Validated",
        "ReadyForPlanning",
        "Assigned",
        "Dispatched",
        "InProgress",
        "Completed",
        "PartiallyCompleted",
        "Failed",
        "Cancelled"
      ],
      "normalTransitions": [
        "Draft>Validated",
        "Validated>ReadyForPlanning",
        "ReadyForPlanning>Assigned",
        "Assigned>Dispatched",
        "Assigned>ReadyForPlanning",
        "Dispatched>InProgress",
        "InProgress>Completed",
        "InProgress>PartiallyCompleted",
        "InProgress>Failed"
      ],
      "preDispatchCancellation": [
        "Draft",
        "Validated",
        "ReadyForPlanning",
        "Assigned"
      ],
      "approvedCompensatingCancellation": [
        "Dispatched",
        "InProgress"
      ],
      "terminal": [
        "Completed",
        "PartiallyCompleted",
        "Failed",
        "Cancelled"
      ],
      "scope": "Condensed composed lifecycle example; authority belongs to each context, not one cross-context aggregate."
    },
    "delivery": {
      "result": [
        "NotDelivered",
        "Partial",
        "Complete"
      ],
      "policy": "Immutable cumulative attempts; complete only when exact booked quantity has evidenced delivery; terminal operational attempts can generate new linked follow-up work."
    },
    "financial": {
      "independentOfOperational": true,
      "states": [
        "QuoteDraft",
        "AgreedRate",
        "ChargesPending",
        "ChargesApproved",
        "InvoiceIssued",
        "PartPaid",
        "Paid",
        "CreditIssued"
      ],
      "policy": "Delivery outcome, invoice issue and settlement are distinct; historical invoice corrected via linked documents.",
      "implemented": false
    }
  },
  "invariants": [
